<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_bp_edu_lab_perbaikan" model="ir.sequence">
            <field name="name">Perbaikan Inventaris Lab</field>
            <field name="code">bp.edu.lab.perbaikan</field>
            <field name="prefix">RP-%(y)s%(month)s%(day)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Format kode sama seperti lab-app: SO-YYMMDD-NNN -->
        <record id="seq_bp_edu_lab_stock_opname" model="ir.sequence">
            <field name="name">Stock Opname Lab</field>
            <field name="code">bp.edu.lab.stock.opname</field>
            <field name="prefix">SO-%(y)s%(month)s%(day)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>

    <!-- Purchase Order mengikuti format lab-app: PO-YYMMDD-NNN -->
    <function model="ir.sequence" name="write">
        <value eval="[ref('purchase.seq_purchase_order')]"/>
        <value eval="{'prefix': 'PO-%(y)s%(month)s%(day)s-', 'padding': 3}"/>
    </function>
</odoo>
