<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="sbs_web_layout" inherit_id="web.layout">
        <xpath expr="//link[@rel='shortcut icon']" position="before">
            <t
                t-set="x_icon"
                t-value="x_icon or '/web/image/res.company/%s/sbs_favicon' % request.env.company.id"
            />
        </xpath>
    </template>
</odoo>
