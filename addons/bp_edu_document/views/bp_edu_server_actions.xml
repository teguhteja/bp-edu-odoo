        <field name="binding_model_id" ref="bp_edu_rps.model_bp_edu_sap"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Mass Unduh SAP',
    'res_model': 'bp.edu.wizard.mass.generate',
    'view_mode': 'form',
    'target': 'new',
    'context': {
        'default_document_type': 'sap',
        'default_sap_ids': [(6, 0, records.ids)],
        'active_model': 'bp.edu.sap',
        'active_ids': records.ids,
    },
}
        </field>
    </record>

</odoo>
