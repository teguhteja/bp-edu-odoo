<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_pager')]" position="before">
            <div
                t-if="this.sbsAutoLoadState and this.sbsCheckRefreshAvailability() and !env.isSmall"
                class="sbs_cp_refresh d-inline-flex align-items-center gap-1 align-self-center"
            >
                <span
                    t-if="this.sbsAutoLoadState.active and this.sbsAutoLoadState.counter &gt; 0"
                    class="small text-muted"
                >
                    <t t-out="this.sbsAutoLoadState.counter"/>s
                </span>
                <button
                    class="btn btn-link p-0 d-inline-flex align-items-center justify-content-center"
                    type="button"
                    t-att-title="this.sbsAutoLoadState.active ? 'Auto Refresh Active (Double-Click to Disable)' : 'Refresh (Double-Click for Auto Refresh)'"
                    t-on-click.stop="this.onClickSbsRefresh"
                    t-on-dblclick.stop="this.onDblClickSbsRefresh"
                >
                    <i
                        class="fa fa-refresh fa-fw"
                        t-att-class="this.sbsAutoLoadState.active ? 'text-info' : 'text-muted'"
                    />
                </button>
            </div>
        </xpath>
    </t>

</templates>
