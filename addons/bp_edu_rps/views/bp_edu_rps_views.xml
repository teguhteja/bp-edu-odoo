<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Form View RPS ─────────────────────────────────────── -->
    <record id="bp_edu_rps_form_view" model="ir.ui.view">
        <field name="name">bp.edu.rps.form</field>
        <field name="model">bp.edu.rps</field>
        <field name="arch" type="xml">
            <form string="Rencana Pembelajaran Semester">
                <header>
                    <button name="action_finalize"
                            string="Finalisasi"
                            type="object"
                            invisible="state == 'final' or is_history_snapshot"
                            class="btn-primary"/>
                    <button name="action_reset_draft"
                            string="Reset ke Draft"
                            type="object"
                            invisible="state == 'draft' or is_history_snapshot"/>
                    <button name="action_buat_detail_kosong"
                            string="Generate 16 Baris Minggu"
                            type="object"
                            invisible="detail_ids or state == 'final' or is_history_snapshot"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,final"
                           readonly="is_history_snapshot"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not is_history_snapshot">
                        <strong>Ini adalah snapshot riwayat</strong> — kondisi RPS ini
                        <field name="snapshot_date" nolabel="1" class="d-inline"/>,
                        sebelum perubahan oleh <field name="snapshot_by_id" nolabel="1" class="d-inline"/>.
                        Data di bawah ini apa adanya saat itu dan tidak bisa diedit atau disimpan.
                        <button name="action_open_live_rps" type="object"
                                string="Buka RPS Saat Ini" class="btn-link p-0 ms-2"
                                invisible="not snapshot_of_id"/>
                    </div>
                    <div class="oe_button_box" name="button_box" invisible="is_history_snapshot">
                        <button class="oe_stat_button" type="object"
                                name="action_view_history" icon="fa-history">
                            <field name="history_count" string="Riwayat" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="mata_kuliah_id" string="RPS"/>
                        <h1>
                            <field name="mata_kuliah_id"
                                   options="{'no_create': True}"
                                   readonly="state == 'final' or is_history_snapshot"
                                   placeholder="Pilih Mata Kuliah..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi">
                            <field name="dosen_id" options="{'no_create': True}"
                                   readonly="state == 'final' or is_history_snapshot"/>
                            <field name="dosen_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   readonly="state == 'final' or is_history_snapshot"/>
                            <field name="tahun_akademik_id" options="{'no_create': True}"
                                   readonly="state == 'final' or is_history_snapshot"/>
                            <field name="tanggal_penyusunan" readonly="state == 'final' or is_history_snapshot"/>
                        </group>
                        <group string="MK">
                            <field name="kode_mk" readonly="1"/>
                            <field name="nama_mk" readonly="1"/>
                            <field name="prodi_id" readonly="1"/>
                            <field name="semester" readonly="1"/>
                        </group>
                    </group>

                    <!-- Detail 16 Minggu -->
                    <notebook>
                        <page string="Detail Perkuliahan (16 Minggu)" name="detail">
                            <field name="detail_ids" nolabel="1"
                                   readonly="state == 'final' or is_history_snapshot">
                                <list editable="bottom"
                                      decoration-muted="minggu == 8"
                                      decoration-info="minggu == 16">
                                    <field name="minggu" readonly="1" optional="show"/>
                                    <field name="deskripsi" optional="show"/>
                                    <field name="indikator" optional="hide"/>
                                    <field name="kriteria" optional="hide"/>
                                    <field name="tatap_muka" optional="hide"/>
                                    <field name="daring" optional="hide"/>
                                    <field name="materi" optional="show"/>
                                    <field name="bobot" optional="show"/>
                                </list>
                                <form string="Detail Minggu">
                                    <group>
                                        <field name="minggu" readonly="1"/>
                                        <field name="bobot"/>
                                    </group>
                                    <group string="Sub-CPMK / Deskripsi">
                                        <field name="deskripsi" nolabel="1"
                                               placeholder="Sub-CPMK yang dicapai minggu ini..."/>
                                    </group>
                                    <group string="Indikator Penilaian">
                                        <field name="indikator" nolabel="1"
                                               placeholder="Ketepatan mahasiswa dalam..."/>
                                    </group>
                                    <group string="Kriteria &amp; Bentuk Penilaian">
                                        <field name="kriteria" nolabel="1"
                                               placeholder="Kuis online; Tugas individu..."/>
                                    </group>
                                    <group>
                                        <group string="Tatap Muka">
                                            <field name="tatap_muka" nolabel="1"
                                                   placeholder="Kuliah interaktif TM: 2x50"/>
                                        </group>
                                        <group string="Daring / Blended">
                                            <field name="daring" nolabel="1"
                                                   placeholder="Kuliah daring sinkron; [TM: 2×50']..."/>
                                        </group>
                                    </group>
                                    <group string="Materi / Pokok Bahasan">
                                        <field name="materi" nolabel="1"
                                               placeholder="Topik materi minggu ini..."/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Korelasi CPMK-Minggu" name="korelasi">
                            <field name="korelasi_ids" nolabel="1"
                                   readonly="state == 'final' or is_history_snapshot">
                                <list editable="bottom">
                                    <field name="cpmk"/>
                                    <field name="m1"/>
                                    <field name="m2"/>
                                    <field name="m3"/>
                                    <field name="m4"/>
                                    <field name="m5"/>
                                    <field name="m6"/>
                                    <field name="m7"/>
                                    <field name="m8"/>
                                    <field name="m9"/>
                                    <field name="m10"/>
                                    <field name="m11"/>
                                    <field name="m12"/>
                                </list>
                            </field>
                        </page>
                        <page string="Korelasi Sub-CPMK-CPL" name="korelasi_cpl">
                            <field name="korelasi_cpl_ids" nolabel="1"
                                   readonly="state == 'final' or is_history_snapshot">
                                <list editable="bottom">
                                    <field name="sub"/>
                                    <field name="p1"/>
                                    <field name="p2"/>
                                    <field name="p3"/>
                                    <field name="p4"/>
                                    <field name="p5"/>
                                    <field name="p6"/>
                                    <field name="p7"/>
                                    <field name="p8"/>
                                    <field name="p9"/>
                                    <field name="p10"/>
                                    <field name="p11"/>
                                    <field name="p12"/>
                                    <field name="p13"/>
                                    <field name="p14"/>
                                    <field name="p15"/>
                                    <field name="p16"/>
                                    <field name="p17"/>
                                    <field name="p18"/>
                                    <field name="p19"/>
                                    <field name="p20"/>
                                    <field name="bobot"/>
                                    <field name="minggu"/>
                                </list>
                            </field>
                        </page>
                        <page string="Matriks Penilaian" name="penilaian">
                            <field name="penilaian_ids" nolabel="1"
                                   readonly="state == 'final' or is_history_snapshot">
                                <list editable="bottom">
                                    <field name="jenis"/>
                                    <field name="bobot"/>
                                    <field name="c1"/>
                                    <field name="c2"/>
                                    <field name="c3"/>
                                    <field name="c4"/>
                                    <field name="c5"/>
                                    <field name="c6"/>
                                    <field name="c7"/>
                                    <field name="c8"/>
                                    <field name="c9"/>
                                    <field name="c10"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rancangan Tugas Proyek" name="rancangan_tugas">
                            <field name="rancangan_tugas_ids" nolabel="1"
                                   readonly="state == 'final' or is_history_snapshot">
                                <list editable="bottom">
                                    <field name="tujuan"/>
                                    <field name="objek_garapan"/>
                                </list>
                                <form string="Rancangan Tugas Proyek">
                                    <group>
                                        <field name="tujuan"/>
                                        <field name="kompetensi"/>
                                    </group>
                                    <group string="Uraian Tugas">
                                        <field name="objek_garapan"/>
                                        <field name="langkah_kerja"/>
                                        <field name="topik"/>
                                        <field name="metode_kerja"/>
                                        <field name="luaran_tugas"/>
                                    </group>
                                    <group string="Kriteria Penilaian">
                                        <group>
                                            <field name="kriteria_proposal_bobot"/>
                                            <field name="kriteria_proposal_deskripsi"/>
                                            <field name="kriteria_implementasi_bobot"/>
                                            <field name="kriteria_implementasi_deskripsi"/>
                                        </group>
                                        <group>
                                            <field name="kriteria_laporan_bobot"/>
                                            <field name="kriteria_laporan_deskripsi"/>
                                            <field name="kriteria_presentasi_bobot"/>
                                            <field name="kriteria_presentasi_deskripsi"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Rubrik Penilaian" name="rubrik">
                            <separator string="Rubrik Holistik Proposal/Laporan"/>
                            <field name="rubrik_holistik_ids" nolabel="1"
                                   readonly="state == 'final' or is_history_snapshot">
                                <list editable="bottom">
                                    <field name="grade"/>
                                    <field name="skor_min"/>
                                    <field name="skor_max"/>
                                    <field name="kriteria"/>
                                </list>
                            </field>
                            <separator string="Rubrik Deskriptif Presentasi"/>
                            <field name="rubrik_deskriptif_ids" nolabel="1"
                                   readonly="state == 'final' or is_history_snapshot">
                                <list editable="bottom">
                                    <field name="aspek_yang_dinilai"/>
                                    <field name="format_penilaian"/>
                                </list>
                                <form string="Rubrik Deskriptif Presentasi">
                                    <group>
                                        <field name="aspek_yang_dinilai"/>
                                        <field name="format_penilaian"/>
                                    </group>
                                    <group string="Skala Penilaian">
                                        <group>
                                            <field name="skala_sangat_kurang_min"/>
                                            <field name="skala_sangat_kurang_max"/>
                                            <field name="skala_kurang_min"/>
                                            <field name="skala_kurang_max"/>
                                            <field name="skala_cukup_min"/>
                                            <field name="skala_cukup_max"/>
                                        </group>
                                        <group>
                                            <field name="skala_baik_min"/>
                                            <field name="skala_baik_max"/>
                                            <field name="skala_sangat_baik_min"/>
                                            <field name="skala_sangat_baik_max"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                    <field name="is_history_snapshot" invisible="1"/>
                    <field name="snapshot_of_id" invisible="1"/>
                </sheet>
                <chatter invisible="is_history_snapshot"/>
            </form>
        </field>
    </record>

    <!-- ─── List View ─────────────────────────────────────────── -->
    <record id="bp_edu_rps_list_view" model="ir.ui.view">
        <field name="name">bp.edu.rps.list</field>
        <field name="model">bp.edu.rps</field>
        <field name="arch" type="xml">
            <list string="RPS"
                  decoration-success="state == 'final'"
                  decoration-muted="state == 'draft'">
                <field name="kode_mk" optional="show"/>
                <field name="nama_mk"/>
                <field name="prodi_id" optional="show"/>
                <field name="semester" optional="show"/>
                <field name="dosen_id" optional="show"/>
                <field name="dosen_ids" widget="many2many_tags" optional="hide"/>
                <field name="tahun_akademik_id" optional="show"/>
                <field name="tanggal_penyusunan" optional="hide"/>
                <field name="snapshot_date" string="Waktu Snapshot" optional="hide"/>
                <field name="snapshot_by_id" string="Snapshot oleh" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'final'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ─── Search View ───────────────────────────────────────── -->
    <record id="bp_edu_rps_search_view" model="ir.ui.view">
        <field name="name">bp.edu.rps.search</field>
        <field name="model">bp.edu.rps</field>
        <field name="arch" type="xml">
            <search string="Cari RPS">
                <field name="mata_kuliah_id"/>
                <field name="dosen_id"/>
                <field name="dosen_ids"/>
                <field name="prodi_id"/>
                <field name="tahun_akademik_id"/>
                <field name="semester"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Final" name="final" domain="[('state', '=', 'final')]"/>
                <group>
                    <filter string="Program Studi" name="group_prodi"
                            context="{'group_by': 'prodi_id'}"/>
                    <filter string="Tahun Akademik" name="group_ta"
                            context="{'group_by': 'tahun_akademik_id'}"/>
                    <filter string="Dosen Koordinator" name="group_dosen"
                            context="{'group_by': 'dosen_id'}"/>
                    <filter string="Semester" name="group_semester"
                            context="{'group_by': 'semester'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Action ────────────────────────────────────────────── -->
    <record id="bp_edu_rps_action" model="ir.actions.act_window">
        <field name="name">RPS</field>
        <field name="res_model">bp.edu.rps</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bp_edu_rps_search_view"/>
    </record>

</odoo>
