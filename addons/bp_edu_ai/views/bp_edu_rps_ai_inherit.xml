<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_open_ai_wizard_rps" model="ir.actions.act_window">
        <field name="name">Generate dengan AI</field>
        <field name="res_model">bp.edu.ai.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_res_model': 'bp.edu.rps',
            'default_res_id': active_id,
        }</field>
    </record>

    <record id="bp_edu_rps_form_ai_inherit" model="ir.ui.view">
        <field name="name">bp.edu.rps.form.ai.inherit</field>
        <field name="model">bp.edu.rps</field>
        <field name="inherit_id" ref="bp_edu_rps.bp_edu_rps_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_button_box')]" position="inside">
                <button name="%(bp_edu_ai.action_open_ai_wizard_rps)d"
                        string="Generate dengan AI"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-magic"/>
            </xpath>
        </field>
    </record>
</odoo>
