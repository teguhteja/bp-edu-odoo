<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bp_edu_upload_rps_wizard_form" model="ir.ui.view">
        <field name="name">bp.edu.upload.rps.wizard.form</field>
        <field name="model">bp.edu.upload.rps.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Dokumen RPS">
                <sheet>
                    <!-- UPLOAD STATE -->
                    <group invisible="state != 'upload'">
                        <field name="rps_id" options="{'no_create': True}" readonly="1"/>
                        <field name="docx_file" filename="docx_filename"/>
                        <field name="docx_filename" invisible="1"/>
                        <field name="use_ai"/>
                    </group>

                    <!-- CHECKED STATE -->
                    <group invisible="state != 'checked'">
                        <field name="rps_id" readonly="1"/>
                        <field name="check_result" nolabel="1" colspan="2" widget="text"
                               style="white-space:pre-wrap; font-family:monospace;"/>
                    </group>

                    <!-- DONE STATE -->
                    <group invisible="state != 'done'">
                        <field name="rps_id" readonly="1"/>
                        <field name="result_summary" nolabel="1"/>
                    </group>

                    <field name="check_ok" invisible="1"/>
                    <field name="detail_cache_json" invisible="1"/>
                    <field name="ai_json_cache" invisible="1"/>
                    <field name="state" invisible="1"/>
                </sheet>

                <footer>
                    <!-- Upload state -->
                    <button name="action_check" string="Cek File"
                            type="object" class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button string="Batal" special="cancel" class="btn-secondary"
                            invisible="state != 'upload'"/>

                    <!-- Checked state -->
                    <button name="action_apply" string="Terapkan Perubahan"
                            type="object" class="btn-primary"
                            invisible="state != 'checked' or not check_ok"
                            confirm="Yakin ingin menerapkan perubahan ini? Data RPS yang ada akan diganti."/>
                    <button name="action_reset" string="Coba File Lain"
                            type="object" class="btn-secondary"
                            invisible="state != 'checked'"/>
                    <button string="Tutup" special="cancel" class="btn-secondary"
                            invisible="state != 'checked'"/>

                    <!-- Done state -->
                    <button name="action_open_rps" string="Buka RPS"
                            type="object" class="btn-primary"
                            invisible="state != 'done'"/>
                    <button string="Tutup" special="cancel" class="btn-secondary"
                            invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bp_edu_upload_rps_wizard_from_rps" model="ir.actions.act_window">
        <field name="name">Upload Dokumen RPS</field>
        <field name="res_model">bp.edu.upload.rps.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_rps_id': active_id, 'dialog_size': 'large'}</field>
    </record>

    <!-- Tombol "Upload Dokumen" di header form RPS -->
    <record id="view_bp_edu_rps_upload_inherit" model="ir.ui.view">
        <field name="name">bp.edu.rps.form.upload.inherit</field>
        <field name="model">bp.edu.rps</field>
        <field name="inherit_id" ref="bp_edu_rps.bp_edu_rps_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[1]" position="before">
                <button name="%(action_bp_edu_upload_rps_wizard_from_rps)d"
                        string="Upload Dokumen"
                        type="action"
                        icon="fa-upload"
                        invisible="is_history_snapshot"/>
            </xpath>
        </field>
    </record>
</odoo>
