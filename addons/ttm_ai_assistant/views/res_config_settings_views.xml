<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_ttm_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.ttm.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Tambahkan blok AI Assistant di akhir form settings -->
            <xpath expr="//form" position="inside">
                <app string="TTM AI Assistant" name="ttm_ai_assistant"
                     groups="base.group_system">

                    <block title="Provider &amp; API Key">
                        <setting string="AI Provider"
                                 help="Groq gratis dengan rate limit. OpenRouter mendukung banyak model. OpenAI berbayar.">
                            <field name="ttm_ai_provider" widget="radio"/>
                        </setting>

                        <setting string="API Key"
                                 help="Masukkan API key dari provider yang dipilih. Disimpan di ir.config_parameter.">
                            <field name="ttm_ai_api_key"
                                   password="True"
                                   placeholder="Groq: gsk_... | OpenRouter: sk-or-... | OpenAI: sk-..."/>
                        </setting>

                        <setting string="Nama Model"
                                 help="Kosongkan untuk default: Groq→llama-3.3-70b-versatile, OpenRouter→deepseek/deepseek-chat, OpenAI→gpt-4o-mini">
                            <field name="ttm_ai_model_name"
                                   placeholder="llama-3.3-70b-versatile"/>
                        </setting>
                    </block>

                    <block title="Parameter LLM">
                        <setting string="Max Tokens"
                                 help="Panjang maksimum respons AI. Default: 2048.">
                            <field name="ttm_ai_max_tokens"/>
                        </setting>

                        <setting string="Temperature"
                                 help="0.0 = deterministik, 1.0 = kreatif. Rekomendasi: 0.3–0.7">
                            <field name="ttm_ai_temperature"/>
                        </setting>
                    </block>

                    <block title="System Prompt">
                        <setting string="System Prompt"
                                 help="Instruksi default untuk AI. Menentukan kepribadian dan batasan AI.">
                            <field name="ttm_ai_system_prompt"
                                   widget="text" rows="5"
                                   placeholder="Kamu adalah asisten AI yang terintegrasi dalam Odoo..."/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

</odoo>
