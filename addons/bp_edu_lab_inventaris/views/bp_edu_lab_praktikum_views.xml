<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bp_edu_lab_praktikum_view_form_bahan" model="ir.ui.view">
        <field name="name">bp.edu.lab.praktikum.form.bahan</field>
        <field name="model">bp.edu.lab.praktikum</field>
        <field name="inherit_id" ref="bp_edu_lab.bp_edu_lab_praktikum_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='kelompok']" position="after">
                <page string="Bahan/Alat" name="bahan">
                    <field name="bahan_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="uom_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
