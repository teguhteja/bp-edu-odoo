        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--
        Baris detail (RPS/SAP/Kontrak): aksesnya mengikuti kepemilikan
        header induk lewat rps_id/sap_id/kontrak_id. Sebelumnya hanya
        header yang punya rule, baris detail-nya terbuka untuk seluruh
