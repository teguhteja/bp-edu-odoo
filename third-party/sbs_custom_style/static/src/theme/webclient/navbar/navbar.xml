<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">

    <t
        t-name="sbs_custom_style.NavBar.AppsMenu"
        t-inherit="web.NavBar.AppsMenu"
        t-inherit-mode="extension"
    >
        <xpath expr="//Dropdown" position="replace">
            <AppsMenu menuClass="'sbs_app_menu'">
                <button data-hotkey="h" title="Home Menu">
                    <i class="oi oi-apps" />
                </button>
                  <t t-set-slot="content">
                    <DropdownItem
                        t-foreach="this.appMenuService.getAppsMenuItems()"
                        t-as="app"
                        t-key="app.id"
                        class="'o_app'"
                        attrs="{ href: app.href, 'data-menu-xmlid': app.xmlid, 'data-section': app.id }"
                        onSelected="() => this.onNavBarDropdownItemSelection(app)"
                        closingMode="'none'"
                    >
                        <a
                            t-att-href="app.href"
                            t-on-click.prevent=""
                        >
                            <img
                                t-if="app.webIconData"
                                class="sbs_app_icon"
                                t-att-src="app.webIconData"
                            />
                            <img
                                t-else=""
                                class="sbs_app_icon"
                                src="/base/static/description/icon.png"
                            />
                            <span class="sbs_app_name">
                                <t t-out="app.label"/>
                            </span>
                        </a>
                    </DropdownItem>
                 </t>
            </AppsMenu>
        </xpath>
    </t>

    <t
        t-name="sbs_custom_style.NavBar.SectionsMenu"
        t-inherit="web.NavBar.SectionsMenu"
        t-inherit-mode="extension"
    >
        <xpath expr="//DropdownItem[@class=&quot;'o_nav_entry'&quot;]" position="attributes">
            <attribute name="class">{
                'o_nav_entry': true,
                'sbs_active_menu_section': this.isSbsSectionActive(section),
            }</attribute>
        </xpath>
        <xpath expr="//Dropdown/button[span[@t-esc='section.name']]" position="attributes">
            <attribute name="t-att-class">{
                'sbs_active_menu_section': this.isSbsSectionActive(section),
            }</attribute>
        </xpath>
        <xpath expr="//Dropdown[button/span[@t-esc='section.name']]" position="attributes">
            <attribute name="menuClass">'sbs_navbar_submenu'</attribute>
        </xpath>
    </t>

    <t
        t-name="sbs_custom_style.NavBar.SectionsMenu.Dropdown.MenuSlot"
        t-inherit="web.NavBar.SectionsMenu.Dropdown.MenuSlot"
        t-inherit-mode="extension"
    >
        <xpath expr="//DropdownItem" position="attributes">
            <attribute name="class">{
                'dropdown-item': true,
                'o_dropdown_menu_group_entry': decalage gt 20,
                'sbs_active_submenu': this.isSbsMenuItemActive(item),
            }</attribute>
        </xpath>
    </t>

    <t
        t-name="sbs_custom_style.NavBar.SectionsMenu.MoreDropdown"
        t-inherit="web.NavBar.SectionsMenu.MoreDropdown"
        t-inherit-mode="extension"
    >
        <xpath expr="//Dropdown" position="attributes">
            <attribute name="menuClass">'sbs_navbar_submenu'</attribute>
        </xpath>
        <xpath expr="//Dropdown/button" position="attributes">
            <attribute name="t-att-class">{
                'sbs_active_menu_section': this.isSbsAnySectionActive(sections),
            }</attribute>
        </xpath>
        <xpath expr="//DropdownItem" position="attributes">
            <attribute name="class">{
                'o_more_dropdown_section': true,
                'sbs_active_submenu': this.isSbsMenuItemActive(section),
            }</attribute>
        </xpath>
    </t>

</templates>
