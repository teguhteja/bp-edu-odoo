<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bp_edu_lab_stock_opname_view_list" model="ir.ui.view">
        <field name="name">bp.edu.lab.stock.opname.list</field>
        <field name="model">bp.edu.lab.stock.opname</field>
        <field name="arch" type="xml">
            <list>
                <field name="kode"/>
                <field name="tanggal"/>
                <field name="user_id"/>
                <field name="referensi"/>
                <field name="state" widget="badge" decoration-success="state == 'selesai'"/>
            </list>
        </field>
    </record>

    <record id="bp_edu_lab_stock_opname_view_form" model="ir.ui.view">
        <field name="name">bp.edu.lab.stock.opname.form</field>
        <field name="model">bp.edu.lab.stock.opname</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validasi" type="object" string="Validasi" class="btn-primary"
                            invisible="state != 'draft'" groups="bp_edu_lab.group_lab_admin"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="kode"/></h1></div>
                    <group>
                        <group>
                            <field name="tanggal" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="referensi"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Barang" name="barang">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="state" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="qty_sistem" column_invisible="parent.state != 'draft'"/>
                                    <field name="qty_sebelum" column_invisible="parent.state == 'draft'"/>
                                    <field name="qty_hitung"/>
                                    <field name="selisih" column_invisible="parent.state == 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan" name="catatan">
                            <field name="catatan"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bp_edu_lab_stock_opname_action" model="ir.actions.act_window">
        <field name="name">Stock Opname</field>
        <field name="res_model">bp.edu.lab.stock.opname</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Laporan penyesuaian stok (laporan-penyesuaian di lab-app) -->
    <record id="bp_edu_lab_stock_opname_line_view_list" model="ir.ui.view">
        <field name="name">bp.edu.lab.stock.opname.line.list</field>
        <field name="model">bp.edu.lab.stock.opname.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="tanggal"/>
                <field name="kode"/>
                <field name="product_id"/>
                <field name="uom_id"/>
                <field name="qty_sebelum"/>
                <field name="qty_hitung"/>
                <field name="selisih" sum="Total"/>
                <field name="stok_sekarang"/>
            </list>
        </field>
    </record>

    <record id="bp_edu_lab_stock_opname_line_view_search" model="ir.ui.view">
        <field name="name">bp.edu.lab.stock.opname.line.search</field>
        <field name="model">bp.edu.lab.stock.opname.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="opname_id"/>
                <filter name="tanggal" string="Tanggal" date="tanggal"/>
                <filter name="group_product" string="Barang" context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="bp_edu_lab_laporan_penyesuaian_action" model="ir.actions.act_window">
        <field name="name">Laporan Penyesuaian Stok</field>
        <field name="res_model">bp.edu.lab.stock.opname.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('opname_id.state', '=', 'selesai')]</field>
    </record>

</odoo>
