<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Form View ─────────────────────────────────────────── -->
    <record id="bp_edu_fakultas_form_view" model="ir.ui.view">
        <field name="name">bp.edu.fakultas.form</field>
        <field name="model">bp.edu.fakultas</field>
        <field name="arch" type="xml">
            <form string="Fakultas">
                <sheet>
                    <div class="oe_title">
                        <label for="nama" string="Nama Fakultas"/>
                        <h1>
                            <field name="nama" placeholder="Contoh: Fakultas Teknologi Informasi"/>
                        </h1>
                    </div>
                    <group>
                        <field name="kode" placeholder="Contoh: FTI"/>
                        <field name="dekan_id" options="{'no_create': True}"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Program Studi" name="prodi">
                            <field name="prodi_ids">
                                <list editable="bottom">
                                    <field name="kode"/>
                                    <field name="nama"/>
                                    <field name="jenjang"/>
                                    <field name="kaprodi_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── List View ─────────────────────────────────────────── -->
    <record id="bp_edu_fakultas_list_view" model="ir.ui.view">
        <field name="name">bp.edu.fakultas.list</field>
        <field name="model">bp.edu.fakultas</field>
        <field name="arch" type="xml">
            <list string="Fakultas">
                <field name="kode"/>
                <field name="nama"/>
                <field name="dekan_id"/>
            </list>
        </field>
    </record>

    <!-- ─── Action ────────────────────────────────────────────── -->
    <record id="bp_edu_fakultas_action" model="ir.actions.act_window">
        <field name="name">Fakultas</field>
        <field name="res_model">bp.edu.fakultas</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
