# PostgreSQL credentials
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=your-db-name
POSTGRES_PORT=15432

# Odoo ports
ODOO_PORT=18069
ODOO_LONGPOLLING_PORT=18072

# Adminer (database browser)
ADMINER_PORT=18070

# Nginx Proxy Manager DB password
NPM_DB_PASSWORD=npmsecret

# Cloudflare R2 (S3-compatible storage) — used by ttm_storage_r2 to auto-create
# the fs.storage record on module install. Never commit real values — this file
# is the template; put actual secrets in .env (gitignored).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
# Optional: custom CDN domain for public attachment URLs
R2_BASE_URL=
# Optional: set to "true" to make R2 the default storage for all new attachments
R2_SET_AS_DEFAULT=false

# Email (used by ttm_email to auto-create Outgoing/Incoming Mail Server on install)
# Outgoing (SMTP) — e.g. Brevo, SendGrid, etc.
EMAIL_SMTP_NAME=SMTP
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# none | starttls_strict | starttls | ssl_strict | ssl
EMAIL_SMTP_ENCRYPTION=starttls_strict
# login | certificate | cli
EMAIL_SMTP_AUTHENTICATION=login
EMAIL_SMTP_PRIORITY=10
EMAIL_SMTP_TEST_CONNECTION=true

# Incoming (IMAP/POP) — e.g. Hostinger catchall mailbox
EMAIL_FETCH_NAME=Incoming Mail
# imap | pop | local
EMAIL_FETCH_TYPE=imap
EMAIL_FETCH_SERVER=imap.hostinger.com
EMAIL_FETCH_PORT=993
EMAIL_FETCH_SSL=true
EMAIL_FETCH_USER=
EMAIL_FETCH_PASSWORD=
EMAIL_FETCH_PRIORITY=5
EMAIL_FETCH_CONFIRM=true
