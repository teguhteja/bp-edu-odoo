<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kartu "Praktikum" di halaman /my -->
    <template id="portal_my_home_praktikum" inherit_id="portal.portal_my_home" name="Portal: Praktikum">
        <xpath expr="//div[@id='portal_common_category']" position="before">
            <div class="o_portal_category row g-2 mt-3" id="portal_praktikum_category">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/bp_edu_lab/static/description/icon.png'"/>
                    <t t-set="title">Praktikum</t>
                    <t t-set="text">Presensi token, upload berkas, pretest/posttest, dan nilai praktikum</t>
                    <t t-set="url" t-value="'/my/praktikum'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="portal_breadcrumbs_praktikum" inherit_id="portal.portal_breadcrumbs" name="Portal: Breadcrumb Praktikum">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'praktikum'" class="breadcrumb-item">Praktikum</li>
        </xpath>
    </template>

    <!-- Akhir ujian praktikum: ganti "Take Again" dengan kembali ke portal praktikum -->
    <template id="survey_button_retake_lab" inherit_id="survey.survey_button_retake" name="Survey: Kembali ke Praktikum">
        <xpath expr="//div[hasclass('d-print-none')]" position="attributes">
            <attribute name="t-if" add="not answer.praktikum_id" separator=" and "/>
        </xpath>
        <xpath expr="//div[hasclass('d-print-none')]" position="after">
            <div t-if="answer.praktikum_id" class="d-print-none">
                <a role="button" class="btn btn-primary btn-lg o_lab_kembali" href="/my/praktikum">Kembali ke Praktikum</a>
            </div>
        </xpath>
    </template>

    <!-- Halaman utama praktikum mahasiswa -->
    <template id="portal_my_praktikum" name="Praktikum Saya">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Praktikum</t>
            </t>

            <div t-if="pesan" t-attf-class="alert alert-#{'success' if status == 'success' else 'danger'} mt-3 o_lab_pesan" role="alert">
                <t t-out="pesan"/>
            </div>

            <div t-if="not mahasiswa" class="alert alert-warning mt-3 o_lab_belum_terhubung" role="alert">
                Akun Anda belum terhubung ke data mahasiswa, hubungi admin.
            </div>

            <t t-elif="not items">
                <p class="mt-3">Anda belum terdaftar di kelompok praktikum mana pun.</p>
            </t>

            <t t-else="">
                <div class="mt-3 mb-2"><strong t-out="mahasiswa.nama"/> &#8212; <span t-out="mahasiswa.nim"/></div>
                <t t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Praktikum</th>
                            <th>Tanggal</th>
                            <th>Presensi</th>
                            <th>Berkas</th>
                            <th>Ujian</th>
                            <th class="text-end">Nilai</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="items" t-as="item" t-att-data-praktikum="item['peserta'].praktikum_id.id" class="o_lab_row">
                            <t t-set="peserta" t-value="item['peserta']"/>
                            <t t-set="praktikum" t-value="peserta.praktikum_id"/>
                            <td>
                                <div class="fw-bold" t-out="praktikum.nama"/>
                                <small class="text-muted" t-out="praktikum.mata_kuliah_id.display_name"/>
                                <div><small t-out="peserta.kelompok_id.nama"/></div>
                            </td>
                            <td><span t-field="praktikum.tanggal"/></td>
                            <td>
                                <span t-if="peserta.presensi" class="badge text-bg-success o_lab_hadir">Hadir</span>
                                <form t-else="" t-attf-action="/my/praktikum/#{praktikum.id}/presensi" method="post" class="d-flex gap-1 o_lab_form_presensi">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="text" name="token" class="form-control form-control-sm" placeholder="Token" maxlength="6" required="required" style="max-width: 7rem;"/>
                                    <button type="submit" class="btn btn-sm btn-primary">Presensi</button>
                                </form>
                            </td>
                            <td>
                                <div t-if="peserta.berkas_nama"><small t-out="peserta.berkas_nama" class="o_lab_berkas_nama"/></div>
                                <form t-attf-action="/my/praktikum/#{praktikum.id}/berkas" method="post" enctype="multipart/form-data" class="d-flex gap-1 o_lab_form_berkas">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="file" name="berkas" class="form-control form-control-sm" required="required"/>
                                    <button type="submit" class="btn btn-sm btn-secondary">Upload</button>
                                </form>
                            </td>
                            <td>
                                <t t-foreach="item['ujian']" t-as="ujian">
                                    <div class="mb-1">
                                        <t t-if="not ujian['ada_soal']">
                                            <small class="text-muted"><t t-out="ujian['label']"/>: belum ada soal</small>
                                        </t>
                                        <t t-else="">
                                            <a t-if="ujian['boleh']" t-attf-href="/my/praktikum/#{praktikum.id}/ujian/#{ujian['jenis']}"
                                               t-attf-class="btn btn-sm #{'btn-outline-primary' if ujian['sudah'] else 'btn-primary'} o_lab_ujian_#{ujian['jenis']}">
                                                <t t-out="ujian['label']"/><t t-if="ujian['sudah']"> (ubah jawaban)</t>
                                            </a>
                                            <small t-else="" class="text-muted">
                                                <t t-out="ujian['label']"/>: <t t-out="'sudah dikerjakan' if ujian['sudah'] else 'ditutup'"/>
                                            </small>
                                        </t>
                                    </div>
                                </t>
                            </td>
                            <td class="text-end o_lab_nilai"><span t-out="'%g' % peserta.nilai"/></td>
                        </tr>
                    </tbody>
                </t>
            </t>
        </t>
    </template>

</odoo>
