<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="eh_ai_model_view_list" model="ir.ui.view">
        <field name="name">eh.ai.model.list</field>
        <field name="model">eh.ai.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="provider_id"/>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="kind"/>
                <field name="supports_tools"/>
                <field name="context_window"/>
                <field name="price_input_per_mtok" string="In $/MTok"/>
                <field name="price_output_per_mtok" string="Out $/MTok"/>
            </list>
        </field>
    </record>

    <record id="eh_ai_model_view_form" model="ir.ui.view">
        <field name="name">eh.ai.model.form</field>
        <field name="model">eh.ai.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Display name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider_id"/>
                            <field name="technical_name"/>
                            <field name="kind"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="context_window"/>
                            <field name="max_output_tokens"/>
                            <field name="embedding_dimensions" invisible="kind != 'embedding'"/>
                        </group>
                    </group>
                    <group string="Capabilities" invisible="kind == 'embedding'">
                        <group>
                            <field name="supports_tools"/>
                            <field name="supports_vision"/>
                            <field name="supports_temperature"/>
                        </group>
                    </group>
                    <group string="Pricing (per million tokens)">
                        <group>
                            <field name="price_input_per_mtok"/>
                            <field name="price_output_per_mtok"/>
                            <field name="price_cached_input_per_mtok"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_ai_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">eh.ai.model</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
