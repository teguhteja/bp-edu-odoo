<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sbs_view_server_action_form" model="ir.ui.view">
        <field name="name">ir.actions.server.form.sbs.refresh</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <xpath
                expr="//t[@name='action_content']//div[hasclass('alert-warning')]"
                position="after"
            >
                <group invisible="state != 'sbs_refresh'">
                    <group>
                        <field
                            name="sbs_refresh_view_types"
                            placeholder="e.g. list, kanban, form"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
