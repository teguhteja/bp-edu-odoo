<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bp_edu_history_snapshot_wizard_form" model="ir.ui.view">
        <field name="name">bp.edu.history.snapshot.wizard.form</field>
        <field name="model">bp.edu.history.snapshot.wizard</field>
        <field name="arch" type="xml">
            <form string="Kondisi Sebelum Perubahan" create="false" edit="false" delete="false">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Tampilan historis, bukan record sungguhan -- tidak bisa diedit atau disimpan.
                    </div>
                    <group>
                        <field name="res_name" string="Record"/>
                        <field name="changed_at"/>
                        <field name="changed_by"/>
                    </group>
                    <group string="Kondisi Sebelum Perubahan Ini">
                        <field name="snapshot_html" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Tutup" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bp_edu_history_snapshot_wizard" model="ir.actions.act_window">
        <field name="name">Kondisi Sebelum Perubahan</field>
        <field name="res_model">bp.edu.history.snapshot.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
