<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bp_edu_lab_praktikum_view_list" model="ir.ui.view">
        <field name="name">bp.edu.lab.praktikum.list</field>
        <field name="model">bp.edu.lab.praktikum</field>
        <field name="arch" type="xml">
            <list>
                <field name="tanggal"/>
                <field name="nama"/>
                <field name="mata_kuliah_id"/>
                <field name="ruang"/>
                <field name="due_date" optional="show"/>
                <field name="token" optional="show"/>
                <field name="token_expired_at" optional="hide"/>
                <field name="jumlah_peserta"/>
                <field name="jumlah_hadir"/>
            </list>
        </field>
    </record>

    <record id="bp_edu_lab_praktikum_view_form" model="ir.ui.view">
        <field name="name">bp.edu.lab.praktikum.form</field>
        <field name="model">bp.edu.lab.praktikum</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_token" type="object" string="Generate Token"
                            class="btn-primary" groups="bp_edu_lab.group_lab_admin"/>
                    <button name="action_buka_penilaian" type="object" string="Penilaian"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_buka_penilaian" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="jumlah_peserta" widget="statinfo" string="Peserta"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="nama"/>
                        <h1><field name="nama" placeholder="mis. Pertemuan 1 - HTML Dasar"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="mata_kuliah_id"/>
                            <field name="ruang"/>
                            <field name="tanggal"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="pretest_id" context="{'default_jenis_ujian': 'pra', 'default_mata_kuliah_id': mata_kuliah_id}"/>
                            <field name="posttest_id" context="{'default_jenis_ujian': 'post', 'default_mata_kuliah_id': mata_kuliah_id}"/>
                            <field name="token" class="fw-bold fs-4"/>
                            <field name="token_expired_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Kelompok" name="kelompok">
                            <field name="kelompok_ids" context="{'default_praktikum_id': id}">
                                <list>
                                    <field name="nama"/>
                                    <field name="kelas_id"/>
                                    <field name="angkatan"/>
                                    <field name="jumlah_anggota"/>
                                    <field name="state" widget="badge" decoration-success="state == 'selesai'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Deskripsi" name="deskripsi">
                            <field name="deskripsi"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bp_edu_lab_praktikum_view_search" model="ir.ui.view">
        <field name="name">bp.edu.lab.praktikum.search</field>
        <field name="model">bp.edu.lab.praktikum</field>
        <field name="arch" type="xml">
            <search>
                <field name="nama"/>
                <field name="mata_kuliah_id"/>
                <field name="ruang"/>
                <filter name="tanggal" string="Tanggal" date="tanggal"/>
                <filter name="group_mk" string="Mata Kuliah" context="{'group_by': 'mata_kuliah_id'}"/>
            </search>
        </field>
    </record>

    <record id="bp_edu_lab_praktikum_view_calendar" model="ir.ui.view">
        <field name="name">bp.edu.lab.praktikum.calendar</field>
        <field name="model">bp.edu.lab.praktikum</field>
        <field name="arch" type="xml">
            <calendar date_start="tanggal" color="mata_kuliah_id" mode="month">
                <field name="mata_kuliah_id"/>
                <field name="ruang"/>
            </calendar>
        </field>
    </record>

    <record id="bp_edu_lab_praktikum_action" model="ir.actions.act_window">
        <field name="name">Praktikum</field>
        <field name="res_model">bp.edu.lab.praktikum</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

</odoo>
