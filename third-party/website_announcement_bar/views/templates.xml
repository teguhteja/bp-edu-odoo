<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Inactive by default: never show a placeholder to live visitors.
     Enabled per-website from the builder via customizeWebsiteViews, which
     flips `active` on the website's COW copy. -->
<template id="announcement_bar" inherit_id="website.layout" active="False"
          name="Announcement Bar">
    <xpath expr="//header" position="before">
        <div class="o_announcement_bar o_announcement_bar_dismissable text-center o_cc o_cc3"
             data-name="Announcement Bar">
            <!-- Hard-coded id is safe: there is exactly one bar per page.
                 The indicators are REQUIRED even though never shown: the
                 native Carousel editor option's _addSlide/_slide code
                 dereferences .carousel-indicators children and crashes
                 without them. d-none only covers first render (_addSlide
                 strips it), so the module SCSS also hides the indicators. -->
            <div id="announcementBarCarousel" class="carousel slide"
                 data-bs-ride="carousel" data-bs-interval="7000">
                <div class="carousel-indicators d-none">
                    <button type="button" data-bs-target="#announcementBarCarousel"
                            data-bs-slide-to="0" class="active" aria-label="Message 1"/>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <p class="mb-0 py-2 px-5">Write your announcement here — <a href="#">add a link if you like</a>.</p>
                    </div>
                </div>
            </div>
            <button type="button" class="o_announcement_bar_close btn-close"
                    title="Close" aria-label="Close"/>
        </div>
    </xpath>
</template>
</odoo>
