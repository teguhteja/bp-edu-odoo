<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fast_lang" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fast_language_switcher</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='languages']" position="after">
                <div id="fast_language_switcher_settings">
                    <block title="Language Switcher" name="fast_language_switcher_block">
                        <setting
                            string="Language Switcher Shortcut"
                            help="Keyboard shortcut to open the quick language switcher overlay. Press the desired key combination inside the field to record it."
                            id="fast_language_switcher_shortcut_setting"
                        >
                            <field
                                name="fast_language_switcher_shortcut"
                                widget="shortcut_input"
                            />
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
