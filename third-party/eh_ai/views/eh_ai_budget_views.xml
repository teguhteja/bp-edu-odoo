<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="eh_ai_budget_view_list" model="ir.ui.view">
        <field name="name">eh.ai.budget.list</field>
        <field name="model">eh.ai.budget</field>
        <field name="arch" type="xml">
            <list decoration-danger="remaining &lt;= 0">
                <field name="name"/>
                <field name="scope"/>
                <field name="period"/>
                <field name="mode"/>
                <field name="limit_amount"/>
                <field name="spent"/>
                <field name="remaining"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="eh_ai_budget_view_form" model="ir.ui.view">
        <field name="name">eh.ai.budget.form</field>
        <field name="model">eh.ai.budget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Monthly cap"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="scope"/>
                            <field name="agent_id" invisible="scope != 'agent'"
                                   required="scope == 'agent'"/>
                            <field name="user_id" invisible="scope != 'user'"
                                   required="scope == 'user'"/>
                            <field name="company_id" invisible="scope != 'company'"
                                   required="scope == 'company'"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="period"/>
                            <field name="limit_amount"/>
                            <field name="mode"/>
                            <field name="spent"/>
                            <field name="remaining"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_ai_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">eh.ai.budget</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
