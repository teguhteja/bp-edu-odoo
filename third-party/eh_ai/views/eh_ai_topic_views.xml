<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="eh_ai_topic_view_list" model="ir.ui.view">
        <field name="name">eh.ai.topic.list</field>
        <field name="model">eh.ai.topic</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="eh_ai_topic_view_form" model="ir.ui.view">
        <field name="name">eh.ai.topic.form</field>
        <field name="model">eh.ai.topic</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Topic name"/></h1>
                    </div>
                    <group>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                    <group string="Instructions">
                        <field name="instructions" nolabel="1"
                               placeholder="Behavioural guidance added to the system prompt..."/>
                    </group>
                    <group string="Tools">
                        <field name="tool_ids" nolabel="1">
                            <list>
                                <field name="eh_ai_tool_name"/>
                                <field name="name"/>
                                <field name="eh_ai_tool_description"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_ai_topic" model="ir.actions.act_window">
        <field name="name">Topics</field>
        <field name="res_model">eh.ai.topic</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
