<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="eh_ai_prompt_view_list" model="ir.ui.view">
        <field name="name">eh.ai.prompt.list</field>
        <field name="model">eh.ai.prompt</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="kind"/>
                <field name="version"/>
            </list>
        </field>
    </record>

    <record id="eh_ai_prompt_view_form" model="ir.ui.view">
        <field name="name">eh.ai.prompt.form</field>
        <field name="model">eh.ai.prompt</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Prompt name"/></h1>
                    </div>
                    <group>
                        <field name="kind"/>
                        <field name="version"/>
                        <field name="active"/>
                    </group>
                    <group string="Body">
                        <field name="body" nolabel="1"
                               placeholder="You are a helpful assistant for..."/>
                    </group>
                    <notebook>
                        <page string="History" name="history">
                            <field name="revision_ids" readonly="1">
                                <list>
                                    <field name="version"/>
                                    <field name="create_date"/>
                                    <field name="create_uid"/>
                                    <field name="is_current"/>
                                    <button name="action_restore" type="object"
                                            string="Restore" icon="fa-undo"
                                            invisible="is_current"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_ai_prompt" model="ir.actions.act_window">
        <field name="name">Prompts</field>
        <field name="res_model">eh.ai.prompt</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
