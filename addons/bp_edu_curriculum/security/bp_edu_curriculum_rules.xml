<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Kaprodi (group_dosen_koordinator): akses penuh ke bp.edu.mata.kuliah,
        tapi hanya untuk mata kuliah milik program studi yang dia pimpin
        (bp.edu.program.studi.kaprodi_id). Dicek lewat dosen_id.user_id
        karena kaprodi_id menunjuk ke bp.edu.dosen, bukan res.users.

        Pengguna dengan akses Administration/Settings (base.group_system,
        mis. akun "administrator") dikecualikan dari pembatasan ini supaya
        tetap bisa melihat seluruh mata kuliah lintas prodi.

        Anggota grup Kaprodi yang BELUM terdaftar sebagai kaprodi resmi di
        prodi manapun (mis. diberi grup untuk keperluan lain) juga
        dikecualikan. Tanpa pengecekan ini, domain di bawah menjadi
        "tidak ada yang cocok" dan mereka kehilangan akses ke SEMUA mata
        kuliah, bukan cuma dibatasi ke satu prodi.

        Kaprodi yang juga ditugaskan mengajar (jadi Dosen Koordinator atau
        Dosen Pengampu di RPS) untuk mata kuliah di PRODI LAIN tetap bisa
        melihat mata kuliah itu, dicek lewat rps_ids (lihat
        bp_edu_rps/models/bp_edu_mata_kuliah_ext.py), supaya penugasan
        mengajar lintas prodi tidak ikut terblokir oleh pembatasan prodi
        sendiri di atas.
    -->
    <record id="rule_mata_kuliah_kaprodi_own_prodi" model="ir.rule">
        <field name="name">Mata Kuliah: Kaprodi hanya melihat milik prodinya</field>
        <field name="model_id" ref="model_bp_edu_mata_kuliah"/>
        <field name="groups" eval="[(4, ref('bp_edu_core.group_dosen_koordinator'))]"/>
        <field name="domain_force">['|', '|', ('prodi_id.kaprodi_id.user_id', '=', user.id), ('rps_ids.dosen_id.user_id', '=', user.id), ('rps_ids.dosen_ids.user_id', '=', user.id)] if not user.has_group('base.group_system') and user.env['bp.edu.program.studi'].sudo().search_count([('kaprodi_id.user_id', '=', user.id)]) else []</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--
        Dekan (group_dekan): melihat mata kuliah di SEMUA program studi yang
        berada di bawah fakultas yang dia pimpin (bp.edu.fakultas.dekan_id),
        bukan cuma satu prodi seperti Kaprodi.

        Pola pengecualian sama seperti rule Kaprodi di atas: superuser dan
        anggota grup Dekan yang belum terdaftar resmi sebagai dekan di
        fakultas manapun tidak dibatasi, supaya tidak ada yang kehilangan
        akses ke SEMUA mata kuliah karena data dekan_id belum diisi.

        Sama seperti rule Kaprodi: Dekan yang mengajar mata kuliah di luar
        fakultasnya sendiri tetap bisa melihatnya lewat rps_ids.
    -->
    <record id="rule_mata_kuliah_dekan_own_fakultas" model="ir.rule">
        <field name="name">Mata Kuliah: Dekan hanya melihat milik fakultasnya</field>
        <field name="model_id" ref="model_bp_edu_mata_kuliah"/>
        <field name="groups" eval="[(4, ref('bp_edu_core.group_dekan'))]"/>
        <field name="domain_force">['|', '|', ('prodi_id.fakultas_id.dekan_id.user_id', '=', user.id), ('rps_ids.dosen_id.user_id', '=', user.id), ('rps_ids.dosen_ids.user_id', '=', user.id)] if not user.has_group('base.group_system') and user.env['bp.edu.fakultas'].sudo().search_count([('dekan_id.user_id', '=', user.id)]) else []</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
